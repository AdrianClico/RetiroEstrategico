msgstr "El análisis de contenido fue bloqueado (HTTP 403/503). Un CDN, firewall o plugin de seguridad está impidiendo que tu servidor cargue la vista previa."

#: inc/admin/ajax/ContentAnalysis.php:72
#: src/Actions/Api/ContentAnalysis.php:288
msgid "Your site could not be reached for content analysis. Please check your server, DNS or firewall configuration."
msgstr "No se pudo acceder a tu sitio para el análisis de contenido. Por favor, verifica la configuración de tu servidor, DNS o firewall."

